# ==============================================================================
#  Orea — variables d'environnement
#  Copier ce fichier en « .env » puis ajuster. Les valeurs ci-dessous suffisent
#  pour la démo locale ; les SECRETS doivent être régénérés pour la production :
#      python -c "import secrets; print(secrets.token_urlsafe(48))"
# ==============================================================================

# --- Application ---------------------------------------------------------------
# development | test | production
ENVIRONMENT=development
# Origines autorisées à appeler l'API (frontend), séparées par des virgules.
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# --- Base de données (utilisées par docker-compose) ------------------------------
POSTGRES_USER=orea
POSTGRES_PASSWORD=orea
POSTGRES_DB=orea
# Port exposé sur la machine hôte (5433 pour ne pas gêner un PostgreSQL déjà installé).
DB_PORT=5433
# Hors Docker (développement, migrations), l'API lit directement cette URL :
DATABASE_URL=postgresql+psycopg://orea:orea@localhost:5433/orea

# --- Authentification ------------------------------------------------------------
# Clé de signature des jetons JWT (32 caractères minimum).
JWT_SECRET=dev-only-change-me-jwt-secret-please-32b
# Durée de vie du jeton d'accès (minutes) et du jeton de rafraîchissement (jours).
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
# true en production (cookie envoyé uniquement en HTTPS).
COOKIE_SECURE=false

# --- Secrets métier ---------------------------------------------------------------
# « Sel secret » du hachage HMAC-SHA256 des numéros de pièce.
# ⚠️ Le changer rend toutes les empreintes existantes invérifiables.
DOC_NUMBER_PEPPER=dev-only-change-me-doc-number-pepper
# Clé de dérivation des jetons des QR codes de retrait.
QR_SECRET=dev-only-change-me-qr-secret

# --- Règles métier ----------------------------------------------------------------
# Score minimal (0–100) pour déclarer une correspondance entre deux noms.
MATCH_THRESHOLD=85
# Score minimal pour qu'un résultat apparaisse dans la recherche publique.
SEARCH_THRESHOLD=75
# Validité d'un QR code de retrait (jours).
PICKUP_CODE_DAYS=14
# Une déclaration sans suite expire après ce délai (jours).
DECLARATION_EXPIRY_DAYS=90
# Échecs de vérification du numéro tolérés, puis durée du verrouillage (heures).
CLAIM_MAX_ATTEMPTS=5
CLAIM_LOCK_HOURS=24

# --- Limitation du nombre de requêtes (par adresse IP) ----------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_SEARCH=30/minute
RATE_LIMIT_VERIFY=5 per 15 minutes
RATE_LIMIT_AUTH=10/minute

# --- E-mails (Mailpit en local : http://localhost:8025) --------------------------
EMAIL_ENABLED=true
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Orea <bonjour@orea.ci>
# true pour un vrai serveur SMTP chiffré (inutile avec Mailpit).
SMTP_STARTTLS=false

# --- Lecture automatique des pièces (OCR) ----------------------------------------
OCR_ENABLED=true
# Langues EasyOCR, séparées par des virgules.
OCR_LANGUAGES=fr,en
# Charge le modèle au démarrage de l'API (le premier scan de la démo est alors rapide).
OCR_PRELOAD=true
# Taille maximale d'une photo envoyée (Mo).
OCR_MAX_UPLOAD_MB=8
# Sous ce score de confiance (0–1), le champ pré-rempli est signalé « à vérifier ».
OCR_REVIEW_THRESHOLD=0.75
# Une photo floutée non rattachée à une déclaration est supprimée après ce délai.
PENDING_UPLOAD_TTL_MINUTES=60
# Limite de scans par adresse IP.
RATE_LIMIT_OCR=10/minute
